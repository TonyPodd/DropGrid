# Development only. Copy to .env. Docker Compose works without this file too.
APP_ENV=development
# Fernet key for local Account token encryption; not DropGrid authentication.
# Generate once using docs/vk-integration.md. Leave empty if token storage is unused.
APP_SECRET_KEY=
# Host-side Alembic/backend URL. Compose replaces hostname with postgres.
DATABASE_URL=postgresql+asyncpg://dropgrid:dropgrid@localhost:5432/dropgrid
# Optional bot: docker compose --profile bot up --build
TELEGRAM_BOT_TOKEN=
POSTGRES_PORT=5432
FRONTEND_PORT=5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
VITE_BACKEND_URL=http://localhost:8000
WORKER_POLL_SECONDS=10

# VK integration: user tokens only. No automatic campaign sending.
VK_API_VERSION=5.199
VK_TIMEOUT_SECONDS=10
# Multipart response read timeout only; connect/write/API calls keep VK_TIMEOUT_SECONDS.
VK_UPLOAD_TIMEOUT_SECONDS=30
VK_MAX_ATTEMPTS=3
# Conservative process-local interval; no platform-limit probing.
VK_MIN_INTERVAL_SECONDS=1
# JPEG/PNG local limit (policy, not a documented VK maximum).
VK_MAX_PHOTO_BYTES=10485760
VK_WRITE_ENABLED=false
VK_TEST_ALLOWED_COMMUNITY_IDS=
# Development-only single Account UUID binding; never pass token as a CLI argument.
VK_TEST_ACCOUNT_ID=
VK_TEST_ACCESS_TOKEN=

# Photo Engine: backend-only secret; no VK dependency.
PIXABAY_API_KEY=
MEDIA_STORAGE_DIR=media
# Unset: one photo may repeat across communities of one campaign without limit.
# PHOTO_MAX_REUSE_PER_ASSET=3
PHOTO_SEARCH_CACHE_HOURS=24
# A photo used in a campaign is not offered to other campaigns for this many days.
PHOTO_REUSE_AFTER_DAYS=90
PHOTO_DOWNLOAD_CONCURRENCY=4
PHOTO_DOWNLOAD_SPARE=3
# Optional CPU-only visual extra; default runtime remains usable without it.
VISUAL_EMBEDDING_ENABLED=false
VISUAL_MODEL_PATH=models/clip-vision-int8.onnx

# Explicit queued media preparation; no VK sending or automatic archive discovery.
CAMPAIGN_REFERENCE_WARMUP_TARGET=12
CAMPAIGN_REFERENCE_RECENT_DAYS=180
MEDIA_PREPARATION_CONCURRENCY=2
VK_READ_CONCURRENCY=1
PHOTO_DOWNLOAD_TIMEOUT_SECONDS=10

# Opt-in sender process; persisted per-account load control.
VK_SEND_INTERVAL_SECONDS=60
VK_STALE_SUGGESTION_DAYS=5

# Optional hosted Pinterest adapter; publication requires separate opt-in.
PINTEREST_SEARCH_ENABLED=false
APIFY_API_TOKEN=
PINTEREST_APIFY_ACTOR=
# Instagram profiles as a photo source (official Graph API, Business Discovery).
# Token of our Business/Creator account with instagram_basic, instagram_manage_insights,
# pages_read_engagement; the account id is its Instagram Business Account ID.
# See docs/instagram-photos.md.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_VERSION=v23.0
# The whole history of a profile is read once, up to this many photos (~250 KB each).
INSTAGRAM_MAX_PHOTOS_PER_PROFILE=1000
INSTAGRAM_SYNC_HOURS=24
# Like Pinterest: open public profiles directly, no token.
INSTAGRAM_DIRECT_ENABLED=true
# Personal public profiles: Apify scraper with APIFY_API_TOKEN above.
INSTAGRAM_APIFY_ACTOR=apify~instagram-post-scraper

# Primary anonymous Pinterest discovery; no credentials.
PINTEREST_DIRECT_ENABLED=true
# Other-community VK photos are preview-only when explicitly opted in.
CROSS_COMMUNITY_REUSE_ENABLED=false

# Discovery priority; publication rights remain unverified, opt-in is explicit.
PHOTO_PRIMARY_MIN_CANDIDATES=16
PHOTO_PRIMARY_TARGET_CANDIDATES=32
PHOTO_FALLBACK_DIVERSITY_CANDIDATES=0
PINTEREST_PUBLICATION_ENABLED=true

# Operational per-campaign quota; not a VK protocol limit.
ACCOUNT_CAMPAIGN_SEND_QUOTA=100
PHOTO_LEARNED_RANKER_MIN_CHOICES=100
PHOTO_LEARNED_RANKER_RETRAIN_CHOICES=25

# Regional selection and bounded, manual read-only discovery
REGIONAL_OWN_ARCHIVE_MIN_AGE_DAYS=365
COMMUNITY_DISCOVERY_SCHEDULE_ENABLED=false
COMMUNITY_DISCOVERY_MAX_QUERIES=12
COMMUNITY_DISCOVERY_MAX_CANDIDATES=30
COMMUNITY_DISCOVERY_VISUAL_CANDIDATES=20
COMMUNITY_DISCOVERY_PHOTOS_PER_CANDIDATE=8
