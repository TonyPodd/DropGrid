# Development only. Copy to .env. Docker Compose works without this file too.
APP_ENV=development
# Reserved for later security features; no authentication currently.
APP_SECRET_KEY=
# Host-side Alembic/backend URL. Compose replaces hostname with postgres.
DATABASE_URL=postgresql+asyncpg://dropgrid:dropgrid@localhost:5432/dropgrid
# Optional bot: docker compose --profile bot up --build
TELEGRAM_BOT_TOKEN=
POSTGRES_PORT=5432
FRONTEND_PORT=5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
VITE_BACKEND_URL=http://localhost:8000
WORKER_POLL_SECONDS=10

# VK integration: user tokens only. No automatic campaign sending.
VK_API_VERSION=5.199
VK_TIMEOUT_SECONDS=10
VK_MAX_ATTEMPTS=3
# Conservative process-local interval; no platform-limit probing.
VK_MIN_INTERVAL_SECONDS=1
# JPEG/PNG local limit (policy, not a documented VK maximum).
VK_MAX_PHOTO_BYTES=10485760
VK_WRITE_ENABLED=false
VK_TEST_ALLOWED_COMMUNITY_IDS=
# Development-only single Account UUID binding; never pass token as a CLI argument.
VK_TEST_ACCOUNT_ID=
VK_TEST_ACCESS_TOKEN=

# Photo Engine: backend-only secret; no VK dependency.
PIXABAY_API_KEY=
MEDIA_STORAGE_DIR=media
PHOTO_MAX_REUSE_PER_ASSET=3
PHOTO_SEARCH_CACHE_HOURS=24
PHOTO_DOWNLOAD_CONCURRENCY=4
PHOTO_DOWNLOAD_SPARE=3
